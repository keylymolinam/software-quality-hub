# Plantilla de variables de entorno.
# Copia este archivo como ".env" y ajusta los valores segun tu maquina.
# El archivo .env NO se sube al repositorio (contiene datos sensibles).

# Puerto en el que escucha la API
PORT=3000

# Entorno de ejecucion: development | production
NODE_ENV=development

# Origen permitido para peticiones desde el frontend (Vite usa 5173 por defecto)
CORS_ORIGIN=http://localhost:5173

# Ruta del archivo de base de datos SQLite (relativa a la carpeta backend/)
DB_PATH=./data/software_quality_hub.sqlite
