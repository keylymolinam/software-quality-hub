# Plantilla de variables de entorno del frontend.
# Copia este archivo como ".env".
#
# Importante: en Vite, solo las variables que empiezan con VITE_ llegan
# al codigo del navegador. Nunca pongas datos secretos aqui: todo lo que
# este en el frontend es visible para cualquier usuario.

VITE_API_URL=http://localhost:3000/api
